<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EmployeeCreateBooking">

    <ImageView
        android:id="@+id/topBar"

        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:scaleType="fitXY"

        android:contentDescription="Background scaler"

        app:srcCompat="@drawable/main_background_scaler_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"

        android:scaleType="fitXY"

        android:contentDescription="Corner slot"

        app:srcCompat="@drawable/primary_corner_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"

        android:scaleType="fitXY"
        android:scaleX="-1"

        android:contentDescription="Corner slot"

        app:srcCompat="@drawable/primary_corner_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.5"

        android:text="Create a Booking"
        android:textSize="16sp"
        android:textColor="@color/white"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/continueButton"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginEnd="24dp"

        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.25"

        android:text="Continue"
        android:textColor="@color/white"

        app:backgroundTint="@color/bookingOrange"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_marginStart="12dp"

        android:orientation="vertical"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <TextView
            android:id="@+id/selectedRoomLabel"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.2"

            android:text="Selected Room: Seminar Room 1"
            android:textSize="16sp"
            android:textColor="?android:textColorPrimary"
            />

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="154dp"

            android:background="@color/bookingOrangePale"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:orientation="vertical"

                android:gravity="center_horizontal"
                >

                <Button
                    android:id="@+id/seminarRoomOneButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Seminar Room 1"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />

                <Button
                    android:id="@+id/seminarRoomTwoButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Seminar Room 2"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />

                <Button
                    android:id="@+id/meetingRoomOneButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Meeting Room 1"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />

                <Button
                    android:id="@+id/meetingRoomTwoButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Meeting Room 2"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />

                <Button
                    android:id="@+id/meetingRoomThreeButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Meeting Room 3"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />

                <Button
                    android:id="@+id/meetingRoomFourButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Meeting Room 4"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />

                <Button
                    android:id="@+id/meetingRoomFiveButton"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.25"

                    android:text="Meeting Room 5"
                    android:textColor="@color/white"

                    app:backgroundTint="@color/bookingOrange"
                    />
            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <include
        android:id="@+id/navigationBar"
        layout="@layout/navigation_bar"
        />
</androidx.constraintlayout.widget.ConstraintLayout>