<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EmployeeDescriptionBooking">

    <ImageView
        android:id="@+id/topBar"

        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:scaleType="fitXY"

        android:contentDescription="Background scaler"

        app:srcCompat="@drawable/main_background_scaler_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"

        android:scaleType="fitXY"

        android:contentDescription="Corner slot"

        app:srcCompat="@drawable/secondary_corner_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"

        android:scaleType="fitXY"
        android:scaleX="-1"

        android:contentDescription="Corner slot"

        app:srcCompat="@drawable/primary_corner_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/backButton"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.25"

        android:layout_marginTop="7dp"
        android:layout_marginStart="7dp"

        android:background="@drawable/main_back_button_img"

        app:backgroundTint="@color/white"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.5"

        android:text="Description"
        android:textSize="16sp"
        android:textColor="@color/white"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center|top"

            android:orientation="vertical"

            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/navigationBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <TextView
                android:id="@+id/selectedRoomLabel"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.2"

                android:layout_marginTop="24dp"

                android:text="Selected Room: Seminar Room 1"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"
                />

            <TextView
                android:id="@+id/bookingDateTime"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.2"

                android:layout_marginTop="24dp"

                android:text="06/11/2026\n09:00-12:00"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"
                />

            <EditText
                android:id="@+id/descriptionInput"

                android:layout_width="256dp"
                android:layout_height="256dp"

                android:layout_marginTop="12dp"

                android:gravity="top|start"

                android:background="@color/bookingOrangePale"

                android:hint="Enter a description here..."

                android:inputType="textMultiLine"

                android:fontFamily="sans-serif-light"

                android:textSize="16sp"
                android:textColor="@color/white"
                />

            <Button
                android:id="@+id/submitButton"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.25"

                android:text="Submit"
                android:textColor="@color/white"

                app:backgroundTint="@color/bookingOrange"
                />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/navigationBar"
        layout="@layout/navigation_bar"
        />

</androidx.constraintlayout.widget.ConstraintLayout>