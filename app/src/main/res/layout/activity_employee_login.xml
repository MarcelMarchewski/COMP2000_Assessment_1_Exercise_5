<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".ActivityEmployeeLogin">

    <ImageView
        android:id="@+id/mainBackground"

        android:layout_width="512dp"
        android:layout_height="512dp"

        android:contentDescription="Background image"

        app:srcCompat="@drawable/login_background_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:scaleType="fitXY"

        android:contentDescription="Background scaler"

        app:srcCompat="@drawable/main_background_scaler_bar"
        app:layout_constraintTop_toTopOf="@id/mainBackground"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/backButton"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.25"

        android:layout_marginTop="36dp"
        android:layout_marginStart="12dp"

        android:background="@drawable/main_back_button_img"

        app:backgroundTint="@color/white"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <LinearLayout
        android:id="@+id/mainLayout"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center|start"

            android:layout_marginTop="12dp"
            android:layout_marginStart="81dp"

            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.5"

            android:text="Log\nIn"
            android:textSize="40sp"
            android:textColor="@color/white"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center|start"

            android:layout_marginTop="32dp"
            android:layout_marginStart="81dp"

            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.5"

            android:text="As an\nemployee"
            android:textSize="14sp"
            android:textColor="@color/white"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>